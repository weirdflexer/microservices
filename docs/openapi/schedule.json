            "type": "string",
            "format": "uuid",
            "title": "Table Id"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "title": "End At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "booking_id",
          "table_id",
          "start_at",
          "end_at"
