            "type": "string",
            "title": "Booking Id"
          },
          "table_id": {
            "type": "string",
            "title": "Table Id"
          },
          "start_at": {
            "type": "string",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "title": "End At"
          },
          "expires_at": {
            "type": "string",
