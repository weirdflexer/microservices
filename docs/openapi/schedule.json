          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/holds": {
      "post": {
        "tags": [
          "Расписание"
        ],
        "summary": "Удержать свободный интервал на срок до 10 минут",
        "operationId": "hold_api_holds_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldRequest"
              }
            }
