{
  "openapi": "3.1.0",
  "info": {
    "title": "Billiards · schedule",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tables/{table_id}/schedule": {
      "put": {
        "tags": [
          "Расписание"
        ],
        "summary": "Задать рабочее окно с проверкой стола в S2",
        "operationId": "set_schedule_api_tables__table_id__schedule_put",
        "parameters": [
          {
            "name": "table_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Table Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tables/{table_id}/availability": {
      "get": {
        "tags": [
          "Расписание"
        ],
        "summary": "Проверить доступность интервала",
        "operationId": "availability_api_tables__table_id__availability_get",
        "parameters": [
          {
            "name": "table_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Table Id"
            }
          },
          {
            "name": "start_at",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Start At"
            }
          },
          {
            "name": "end_at",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "End At"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
