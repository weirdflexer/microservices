          "start_at": {
            "type": "string",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "title": "End At"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "busy_intervals": {
            "items": {
              "$ref": "#/components/schemas/HoldResponse"
            },
            "type": "array",
            "title": "Busy Intervals"
          }
