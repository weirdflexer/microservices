  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "title": "Booking Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "const": "RUB",
            "title": "Currency"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "failed",
              "succeeded"
            ],
            "title": "Status"
          },
          "refund_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pending",
                  "failed",
                  "succeeded"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Status"
          },
          "refunded_amount": {
            "type": "integer",
            "title": "Refunded Amount"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "payment_url": {
            "type": "string",
            "title": "Payment Url"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "refund_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "booking_id",
          "user_id",
          "amount",
          "currency",
          "status",
          "refund_status",
          "refunded_amount",
          "created_at",
          "payment_url",
          "provider"
        ],
        "title": "PaymentResponse"
      },
      "PaymentResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Status"
          },
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "Сумма в копейках"
          },
          "currency": {
            "type": "string",
            "const": "RUB",
            "title": "Currency",
            "default": "RUB"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "amount"
        ],
        "title": "PaymentResult"
      },
      "RefundResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "RefundResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:8006"
    }
  ]
}
